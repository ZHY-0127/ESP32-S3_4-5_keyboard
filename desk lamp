#include <Arduino.h>
#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>

// =======================
// BLE UUID（需與控制端一致）
// =======================
#define SERVICE_UUID        "12345678-1234-1234-1234-1234567890ab"
#define CHARACTERISTIC_UUID "abcd1234-5678-1234-5678-1234567890ab"

// =======================
// LED 設定
// =======================
const int ledPin = 5;   // LED PWM 輸出腳位
uint8_t currentBrightness = 0; // 實際輸出的亮度（0~255）
uint8_t targetBrightness = 0;  // 目標亮度（由 BLE 寫入）

// =======================
// BLE 物件
// =======================
BLECharacteristic *pCharacteristic;
bool deviceConnected = false; // 是否有控制端連線

// =======================
// PWM 設定
// =======================
const int pwmChannel = 0;
const int pwmFreq = 5000;
const int pwmResolution = 8;

// =======================
// 連線回呼（僅用於紀錄狀態與除錯輸出）
// =======================
class MyServerCallbacks : public BLEServerCallbacks {
  void onConnect(BLEServer* pServer) {
    deviceConnected = true;
    Serial.println("Client Connected");
  }

  void onDisconnect(BLEServer* pServer) {
    deviceConnected = false;
    Serial.println("Client Disconnected");
    BLEDevice::startAdvertising();  // 斷線後自動重新廣播，等待下一次連線
  }
};

// =======================
// 收到亮度資料時
// =======================
class BrightnessCallback : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pCharacteristic) {

    std::string value = pCharacteristic->getValue();

    if (value.length() == 1) {
      // 協議：控制端傳 1 byte，直接表示亮度 0~255
      targetBrightness = static_cast<uint8_t>(value[0]);

      Serial.print("Brightness Received: ");
      Serial.println(targetBrightness);
    } else {
      Serial.print("Invalid payload length: ");
      Serial.println(value.length());
    }
  }
};

// =======================
// SETUP
// =======================
void setup() {

  Serial.begin(115200);

  // PWM 初始化
  // 8-bit 解析度 => duty 範圍 0~255，剛好對應接收的亮度值
  ledcSetup(pwmChannel, pwmFreq, pwmResolution);
  ledcAttachPin(ledPin, pwmChannel);

  // BLE 初始化（建立 GATT Server）
  BLEDevice::init("SmartLamp");
  BLEServer *pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());

  BLEService *pService = pServer->createService(SERVICE_UUID);

  // 建立可寫入的亮度特徵值（控制端透過 write 發送亮度）
  pCharacteristic = pService->createCharacteristic(
                      CHARACTERISTIC_UUID,
                      BLECharacteristic::PROPERTY_WRITE
                    );

  pCharacteristic->setCallbacks(new BrightnessCallback());

  pService->start();

  // 開始廣播，讓控制端可以掃描到本裝置
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->start();

  Serial.println("Lamp BLE Ready");
}

// =======================
// LOOP
// =======================
void loop() {
  // 簡單漸變：每 5ms 調整 1 階，避免亮度跳變
  if (currentBrightness < targetBrightness) {
    currentBrightness++;
    ledcWrite(pwmChannel, currentBrightness);
  } else if (currentBrightness > targetBrightness) {
    currentBrightness--;
    ledcWrite(pwmChannel, currentBrightness);
  }

  delay(5);
}

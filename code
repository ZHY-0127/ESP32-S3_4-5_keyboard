#include <Arduino.h>
#include "USB.h"
#include "USBHIDKeyboard.h"
#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEClient.h>

// =======================
// USB HID
// =======================
USBHIDKeyboard Keyboard;

// =======================
// CE-11 亮度控制
// =======================
const int ce11Pin = 4;   // ADC腳位
int brightness = 0;
int lastBrightness = -1;

// =======================
// BLE 設定（與檯燈一致）
// =======================
#define SERVICE_UUID        "12345678-1234-1234-1234-1234567890ab"
#define CHARACTERISTIC_UUID "abcd1234-5678-1234-5678-1234567890ab"

BLEClient* pClient;
BLERemoteCharacteristic* pRemoteCharacteristic;
bool deviceConnected = false;

// =======================
// BLE 連線
// =======================
void connectToLamp() {

  BLEDevice::init("");
  pClient = BLEDevice::createClient();

  BLEScan* pBLEScan = BLEDevice::getScan();
  pBLEScan->setActiveScan(true);
  BLEScanResults results = pBLEScan->start(5);

  for (int i = 0; i < results.getCount(); i++) {
    BLEAdvertisedDevice device = results.getDevice(i);

    if (device.haveServiceUUID() &&
        device.isAdvertisingService(BLEUUID(SERVICE_UUID))) {

      pClient->connect(&device);
      BLERemoteService* pRemoteService =
        pClient->getService(SERVICE_UUID);

      if (pRemoteService != nullptr) {
        pRemoteCharacteristic =
          pRemoteService->getCharacteristic(CHARACTERISTIC_UUID);

        if (pRemoteCharacteristic != nullptr) {
          deviceConnected = true;
          Serial.println("Connected to Lamp");
          return;
        }
      }
    }
  }

  Serial.println("Lamp not found");
}

// =======================
// SETUP
// =======================
void setup() {

  Serial.begin(115200);

  // USB HID
  USB.begin();
  Keyboard.begin();

  // ADC
  pinMode(ce11Pin, INPUT);

  // BLE
  connectToLamp();
}

// =======================
// LOOP
// =======================
void loop() {

  // ===== 讀取 CE-11 =====
  int adcValue = analogRead(ce11Pin);
  brightness = map(adcValue, 0, 4095, 0, 255);

  // ===== 若亮度變化才傳送 =====
  if (brightness != lastBrightness) {

    Serial.print("Brightness: ");
    Serial.println(brightness);

    // USB HID 傳送 (示範：按下 F13~F24 可自訂)
    Keyboard.press(KEY_MEDIA_VOLUME_UP);
    delay(10);
    Keyboard.releaseAll();

    // BLE 傳送亮度給檯燈
    if (deviceConnected && pRemoteCharacteristic) {
      pRemoteCharacteristic->writeValue(&brightness, 1);
    }

    lastBrightness = brightness;
  }

  delay(50);
}
